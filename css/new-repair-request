* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    background-color: white;
    color: black;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    line-height: 1.6;
}

.container {
    margin: 0 auto;
    max-width: 1440px;
}

.header {
    align-items: center;
    border-bottom: 1px solid #e5e7eb;
    display: flex;
    justify-content: space-between;
    padding: 32px 48px;
}

.header h1 {
    color: black;
    font-size: 30px;
    font-weight: bold;
}

.main-content {
    padding: 32px 48px;
}

.card {
    background-color: white;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    margin-bottom: 32px;
    padding: 24px;
}

.form-group {
    margin-bottom: 12px;
}

label {
    color: black;
    display: block;
    font-size: 16px;
    font-weight: 500;
    margin-bottom: 8px;
}

select,
textarea,
input[type="text"] {
    border: 1px solid #d1d5db;
    border-radius: 6px;
    font-family: inherit;
    font-size: 16px;
    padding: 10px 12px;
    width: 100%;
}

select:focus,
textarea:focus,
input[type="text"]:focus {
    border-color: #2563eb;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
    outline: none;
}

textarea {
    min-height: 128px;
    resize: vertical;
}

.separator {
    background-color: #e5e7eb;
    height: 1px;
    margin: 24px 0;
}

.helper-text {
    color: #6b7280;
    font-size: 14px;
    margin-top: 8px;
}

.btn {
    border: none;
    border-radius: 6px;
    cursor: pointer;
    font-size: 16px;
    font-weight: 500;
    padding: 10px 24px;
    transition: background-color 0.2s;
}

.btn-primary {
    background-color: #2563eb;
    color: white;
}

.btn-primary:hover {
    background-color: #1d4ed8;
}

.btn-large {
    font-size: 18px;
    padding: 24px 48px;
}

.submit-section {
    display: flex;
    justify-content: center;
    padding-bottom: 32px;
}

.custom-modal {
    align-items: center;
    background-color: rgba(0, 0, 0, 0.5);
    display: flex;
    inset: 0;
    justify-content: center;
    padding: 16px;
    position: fixed;
    z-index: 1000;
}

.custom-modal.hidden {
    display: none;
}

.custom-modal-content {
    background-color: white;
    border-radius: 8px;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
    max-width: 400px;
    padding: 24px;
    width: 100%;
}

.custom-modal-header {
    align-items: center;
    display: flex;
    justify-content: space-between;
    margin-bottom: 16px;
}

.custom-modal-header h2 {
    font-size: 20px;
    font-weight: 600;
}

.custom-modal-close {
    background: none;
    border: none;
    color: #9ca3af;
    cursor: pointer;
    font-size: 24px;
}

.custom-modal-body {
    margin-bottom: 24px;
}

.custom-modal-footer {
    display: flex;
    justify-content: flex-end;
}

.hidden {
    display: none;
}

.preloader {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(255, 255, 255, 0.9);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
}
.preloader.hidden {
    display: none;
}
.spinner {
    width: 50px;
    height: 50px;
    border: 5px solid #e5e7eb;
    border-top-color: #2563eb;
    border-radius: 50%;
    animation: spin 1s linear infinite;
}
@keyframes spin {
    to { transform: rotate(360deg); }
}

@media (max-width: 320px) {
    .header {
        padding: 16px;
    }
    .header h1 {
        font-size: 22px;
    }
    .main-content {
        padding: 16px;
    }
    .card {
        padding: 16px;
        margin-bottom: 20px;
    }
    .btn-large {
        font-size: 16px;
        padding: 16px 24px;
    }
    .submit-section {
        padding-bottom: 20px;
    }
}

@media (max-width: 640px) {
    .header {
        padding: 24px 32px;
    }
    .header h1 {
        font-size: 28px;
    }
    .main-content {
        padding: 24px 32px;
    }
}

@media (max-width: 480px) {
    .header {
        padding: 16px 20px;
    }
    .header h1 {
        font-size: 24px;
    }
    .main-content {
        padding: 16px 20px;
    }
    .card {
        padding: 16px;
        margin-bottom: 20px;
    }
    .btn-large {
        font-size: 16px;
        padding: 16px 24px;
    }
}

@media (max-width: 360px) {
    .header h1 {
        font-size: 22px;
    }
    .card {
        padding: 12px;
        margin-bottom: 16px;
    }
    label {
        font-size: 14px;
    }
    select, textarea, input {
        font-size: 14px;
        padding: 8px 10px;
    }
    .btn-large {
        font-size: 14px;
        padding: 12px 20px;
    }
    .submit-section {
        padding-bottom: 16px;
    }
}

@media (max-width: 320px) {
    .header h1 {
        font-size: 20px;
    }
    .btn-large {
        font-size: 13px;
        padding: 10px 16px;
    }
}
